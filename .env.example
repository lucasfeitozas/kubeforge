KUBEFORGE_HTTP_PORT=8080
KUBEFORGE_KUBECONFIG=~/.kube/config
KUBEFORGE_DB_PATH=./kubeforge.db
LOG_LEVEL=info

# Token de acesso para repositórios privados clonados pelo Build Broker.
# O nome da env var é KUBEFORGE_GIT_TOKEN_<credentialsSecretRef em maiúsculas>,
# onde <credentialsSecretRef> é o valor informado em source.credentialsSecretRef
# do Componente. Exemplo para credentialsSecretRef: "github-readonly-token":
# KUBEFORGE_GIT_TOKEN_GITHUB_READONLY_TOKEN=ghp_xxx
